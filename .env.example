# Alto AI Support Orchestrator — environment template.
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────
APP_ENV=local                      # local | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────────────────────────────────
# PostgreSQL — domain records, wide-event spans, LangGraph checkpoints
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=alto
POSTGRES_PASSWORD=alto
POSTGRES_DB=alto
POSTGRES_PORT=5432
POSTGRES_HOST=localhost            # `postgres` when running inside Compose

# ─────────────────────────────────────────────────────────────────────
# Redis — short-term memory and stream buffers
# ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_HOST=localhost               # `redis` when running inside Compose
REDIS_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────
# Qdrant — hybrid vector store
# ─────────────────────────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HOST=localhost              # `qdrant` inside Compose, or a full
                                    # https://...cloud.qdrant.io URL for Qdrant Cloud
QDRANT_API_KEY=                    # required for Qdrant Cloud, blank for local Docker
QDRANT_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────
# LLM providers
#
# LLM_PROVIDER=mock needs no API key at all. The Mock provider is
# deterministic and powers CI plus a zero-cost end-to-end demo.
# ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=mock                  # mock | openai | anthropic

OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_PREMIUM_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PREMIUM_MODEL=claude-opus-5

# Phrases clarifying questions only — never the main reply. Optional: leave it
# empty and clarification falls back to the templates in intents.yaml, exactly
# as it behaved before. A free key from console.groq.com is enough.
GROQ_API_KEY=
# llama-3.1-8b-instant is the faster, larger-quota alternative if the free
# daily token budget on 70B runs out.
GROQ_MODEL=llama-3.3-70b-versatile
# Ceiling on the clarification call. The customer is waiting and the template
# is already correct, so a slow model is dropped rather than waited on.
CLARIFIER_TIMEOUT_SECONDS=4.0

# Daily spend ceiling in USD. Breaching it demotes premium requests to the
# fast tier rather than failing them.
LLM_DAILY_BUDGET_USD=5.00

# ─────────────────────────────────────────────────────────────────────
# Embeddings & reranking — all local, no API key, no per-query cost.
# Cross-lingual so Arabic queries retrieve the English source documents.
# ─────────────────────────────────────────────────────────────────────
DENSE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DENSE_EMBEDDING_DIM=384
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Retrieval funnel — see docs/REFERENCE_PATTERNS.md §1.2
RETRIEVAL_PREFETCH_LIMIT=100
RETRIEVAL_FUSION_TOP_K=20
RETRIEVAL_RERANK_TOP_K=5
RETRIEVAL_RRF_K=2                  # Qdrant default; literature uses 60
RETRIEVAL_RERANK_ENABLED=true       # false skips the cross-encoder — saves
                                    # real memory on constrained deployments

# ─────────────────────────────────────────────────────────────────────
# Decision thresholds — canonical, from docs/spec/04_MODEL_ROUTING.md
#
#   decision_score = 100 x (0.25*intent + 0.20*retrieval + 0.15*language
#                           + 0.20*risk + 0.20*policy)
#
# Weights themselves live in domain/policies/*.yaml, not here — they are
# business rules under version control, not deployment configuration.
# ─────────────────────────────────────────────────────────────────────
CONFIDENCE_AUTO_THRESHOLD=90       # >= 90  -> fast model, auto
CONFIDENCE_PREMIUM_THRESHOLD=75    # 75-89  -> premium model
                                   # <  75  -> human handoff

# Master kill-switch. When false, every reply is drafted for human approval
# and nothing reaches a customer unreviewed.
ALLOW_AUTO_SEND=false

# ─────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API. 127.0.0.1 equivalents are added
# automatically — browsers treat them as distinct origins from localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-any-non-local-use
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720

# ─────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
