# ── Secrets ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ── Node / Next.js ───────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
.npm/
.eslintcache

